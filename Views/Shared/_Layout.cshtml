<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Pulse — Every problem has a pattern")</title>
    <meta name="description" content="Pulse is a thoughtful, structured platform for identifying, tracking, and understanding recurring everyday problems." />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Pulse Base Styles & DM Sans Typography -->
    <link rel="stylesheet" href="~/css/pulse-base.css" />
    
    <!-- Pulse Polish Styles (Auth & Landing) -->
    <link rel="stylesheet" href="~/css/pulse-polish.css" />
    
    <!-- Pulse Interactive App Styles -->
    <link rel="stylesheet" href="~/css/pulse-app.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
